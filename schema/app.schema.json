{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mobilespec:app",
  "title": "App Config (app.yaml)",
  "type": "object",
  "required": ["version", "groups"],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {
      "description": "拡張プロパティ（検証しない。プロジェクト固有のメモ用）"
    }
  },
  "properties": {
    "version": {
      "const": 2,
      "description": "仕様の書式のバージョン"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "description": "画面のグループ（遷移図・索引の並び）。L2 の group は、ここにあるものだけ"
    },
    "screenOrder": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "description": "グループ内の画面の並び（任意。無い画面は ID 順で後ろ）"
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "ロケール。ja は仕様から生成する元"
    },
    "openapi": {
      "type": "string",
      "minLength": 1,
      "description": "OpenAPI（bundled）のパス。app.yaml からの相対パス"
    },
    "facts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          }
        }
      },
      "description": "アプリ全体の事実（画面の状態では決まらない真偽値）。実装側が提供する"
    }
  }
}
