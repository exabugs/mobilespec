{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mobilespec:L4.state",
  "title": "State / Data / Behavior (L4)",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {
      "description": "拡張プロパティ（検証しない。プロジェクト固有のメモ用）"
    }
  },
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "queries": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "required": ["operationId"],
            "additionalProperties": false,
            "properties": {
              "operationId": {
                "type": "string",
                "minLength": 1,
                "description": "OpenAPI の operationId"
              },
              "args": {
                "type": "object",
                "additionalProperties": true,
                "description": "OpenAPI の引数への引き渡し（参照 $x.y またはリテラル）"
              },
              "description": {
                "type": "string"
              },
              "selectRoot": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "mutations": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "required": ["operationId"],
            "additionalProperties": false,
            "properties": {
              "operationId": {
                "type": "string",
                "minLength": 1,
                "description": "OpenAPI の operationId"
              },
              "args": {
                "type": "object",
                "additionalProperties": true,
                "description": "OpenAPI の引数への引き渡し（参照 $x.y またはリテラル）"
              },
              "description": {
                "type": "string"
              },
              "options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "idempotent": {
                    "type": "boolean"
                  },
                  "retry": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "retryDelay": {
                    "enum": ["exponential", "linear", "none"]
                  },
                  "optimistic": {
                    "type": "boolean"
                  },
                  "errorDisplay": {
                    "enum": ["toast", "inline", "none"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "type"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": ["device", "storage"]
          },
          "type": {
            "type": ["string", "array", "object"],
            "description": "型。string / number / integer / boolean / unknown、[T]、{ a: T, b: 'T?' }、{ $ref }"
          },
          "description": {
            "type": "string"
          },
          "default": {}
        }
      },
      "description": "API 以外のデータ源"
    },
    "state": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "type": {
            "type": ["string", "array", "object"],
            "description": "型。string / number / integer / boolean / unknown、[T]、{ a: T, b: 'T?' }、{ $ref }"
          },
          "enum": {
            "type": "array"
          },
          "default": {},
          "description": {
            "type": "string"
          }
        }
      },
      "description": "画面ローカルの状態（型付き）"
    },
    "conditions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["expr"],
        "additionalProperties": false,
        "properties": {
          "expr": {
            "type": "string",
            "minLength": 1,
            "description": "式。演算子を持つ式は、ここにだけ書ける"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "名前付きの式"
    },
    "events": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/event"
      },
      "description": "画面内の振る舞い。遷移の行き先は書かない"
    },
    "constants": {
      "type": "object",
      "additionalProperties": true
    },
    "description": {
      "type": "string"
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["steps"],
      "additionalProperties": false,
      "properties": {
        "when": {
          "type": "string",
          "minLength": 1,
          "description": "実行できる条件。参照だけ（L4 の conditions の名前など）"
        },
        "on": {
          "enum": ["ui", "enter"],
          "default": "ui",
          "description": "ui: L3 の action が起動 / enter: 画面表示時"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "onError": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "description": "mutate が失敗したときのステップ"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "mutate": {
          "type": "string",
          "description": "data.mutations のキー"
        },
        "refetch": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "data.queries のキーの配列"
        },
        "set": {
          "type": "object",
          "description": "{ state の名前: 値（参照またはリテラル） }"
        },
        "go": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "同じ画面の L2 の遷移 ID。行き先・params は L2 が持つ"
        },
        "external": {
          "type": "string",
          "description": "外部（SDK・OS）に処理を委ねる。説明"
        }
      }
    }
  }
}
